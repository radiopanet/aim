{
  "manifest_version": 3,
  "name": "Aim",
  "version": "1.0.0",
  "description": "Plan tomorrow's goals tonight and track them each day.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "Aim",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "radiopanethabo323@gmail.com",
      "strict_min_version": "128.0"
    }
  }
}